# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NÃO vai para o GitHub.

# Banco PostgreSQL (o docker-compose sobe um local na porta 5433)
DATABASE_URL="postgresql://username:password@localhost:5433/database_name?schema=public"

# Chave para assinar os tokens de login. Em produção, use uma chave longa e aleatória.
JWT_SECRET="troque-esta-chave"

# Porta da API
PORT=3000

# Endereço do front-end: usado no link do e-mail de "esqueci minha senha"
FRONT_URL="http://localhost:5173"

# Quem pode chamar a API pelo navegador (CORS). Vazio = qualquer origem (desenvolvimento).
# Em produção: o endereço do front. Vários separados por vírgula.
CORS_ORIGIN=

# Envio de e-mail. Usa o primeiro que estiver preenchido:
#   1. BREVO_API_KEY (envio por HTTPS; use este em produção no Render)
#   2. SMTP_HOST (ex.: Gmail com senha de app)
# Sem nenhum dos dois, os e-mails não são enviados: o conteúdo aparece no terminal da API.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente. No Brevo, precisa ser um e-mail confirmado em "Senders".
EMAIL_REMETENTE="SemeAR <seu-email@gmail.com>"

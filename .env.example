# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NÃO vai para o GitHub.

# Banco PostgreSQL (o docker-compose sobe um local na porta 5433)
DATABASE_URL="postgresql://username:password@localhost:5433/database_name?schema=public"

# Chave para assinar os tokens de login. Em produção, use uma chave longa e aleatória.
JWT_SECRET="troque-esta-chave"

# Porta da API
PORT=3000

# Endereço do front-end: usado no link do e-mail de "esqueci minha senha"
FRONT_URL="http://localhost:5173"

# Envio de e-mail (SMTP). Sem SMTP_HOST, os e-mails não são enviados:
# o conteúdo aparece no terminal da API (serve para testar em desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="SemeAR <nao-responda@seu-dominio.com>"

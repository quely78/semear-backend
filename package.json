{
  "name": "semear-backend",
  "version": "1.0.0",
  "description": "API back-end do SemeAR com Express, Prisma e PostgreSQL",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:seed": "node prisma/seed.js",
    "email:teste": "node scripts/testar-email.js",
    "start:render": "prisma migrate deploy && node prisma/seed.js && node src/app.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "nodemon": "latest",
    "prisma": "^6.19.0"
  },
  "engines": {
    "node": ">=20 <25"
  }
}

{
  "name": "semear-backend",
  "version": "1.0.0",
  "description": "API back-end do SemeAR com Express, Prisma e PostgreSQL",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:seed": "node prisma/seed.js",
    "email:teste": "node scripts/testar-email.js",
    "start:render": "prisma migrate deploy && node prisma/seed.js && node src/app.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20 <25"
  }
}

# =============================================================
# .env.example — Modelo das variáveis de ambiente do front-end.
# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NÃO vai para o GitHub (está no .gitignore).
# =============================================================

# Endereço da API do SemeAR (semear-backend).
# Em desenvolvimento o back-end roda em http://localhost:3000
VITE_API_URL=http://localhost:3000

# Modo demonstração: "true" usa dados de exemplo e funciona SEM o back-end
# (bom para apresentar as telas). Use "false" quando o back-end estiver pronto.
VITE_MODO_DEMO=true
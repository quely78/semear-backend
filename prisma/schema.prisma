generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agricultora {
  id           Int        @id @default(autoincrement())
  nome         String
  contato      String     @unique
  senhaHash    String
  comunidadeId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comunidade   Comunidade @relation(fields: [comunidadeId], references: [id])
  plantios     Plantio[]
}

model Coordenadora {
  id           Int         @id @default(autoincrement())
  nome         String
  contato      String      @unique
  senhaHash    String
  comunidadeId Int?        @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  comunidade   Comunidade? @relation(fields: [comunidadeId], references: [id])
}

model Comunidade {
  id           Int           @id @default(autoincrement())
  nome         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agricultoras Agricultora[]
  coordenadora Coordenadora?
}

model Plantio {
  id            Int         @id @default(autoincrement())
  especie       String
  dataPlantio   DateTime
  area          Float
  tipoCultivo   String
  agricultoraId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  agricultora   Agricultora @relation(fields: [agricultoraId], references: [id], onDelete: Cascade)

  @@index([especie])
  @@index([dataPlantio])
}

model CalendarioAgricola {
  id            Int    @id @default(autoincrement())
  especie       String @unique
  epocaPlantio  String
  epocaColheita String
}

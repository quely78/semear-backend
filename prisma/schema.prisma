generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agricultora {
  id           Int        @id @default(autoincrement())
  nome         String
  contato      String     @unique
  senhaHash    String
  // true quando a responsável gerou uma senha provisória: no próximo login ela cria uma nova
  senhaProvisoria Boolean @default(false)
  comunidadeId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comunidade   Comunidade @relation(fields: [comunidadeId], references: [id])
  plantios     Plantio[]
}

model Coordenadora {
  id           Int         @id @default(autoincrement())
  nome         String
  contato      String      @unique
  senhaHash    String
  comunidadeId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  comunidade   Comunidade? @relation(fields: [comunidadeId], references: [id])

  @@index([comunidadeId])
}

model Comunidade {
  id           Int           @id @default(autoincrement())
  nome         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agricultoras Agricultora[]
  coordenadoras Coordenadora[]
}

model Plantio {
  id            Int         @id @default(autoincrement())
  especie       String
  dataPlantio   DateTime
  area          Float
  tipoCultivo   String
  // Colheita (saída do estoque): preenchidos quando a agricultora registra a colheita
  dataColheita      DateTime?
  quantidadeColhida Float?
  agricultoraId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  agricultora   Agricultora @relation(fields: [agricultoraId], references: [id], onDelete: Cascade)

  @@index([especie])
  @@index([dataPlantio])
}

// Pedido de "esqueci minha senha" por e-mail. Guarda só o HASH do token do link,
// nunca o token em si. Vale 30 minutos e só pode ser usado uma vez.
model RedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  tipo      String    // AGRICULTORA ou COORDENADORA (a conta pode estar em qualquer das duas tabelas)
  usuarioId Int
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([tipo, usuarioId])
}

model CalendarioAgricola {
  id            Int    @id @default(autoincrement())
  especie       String @unique
  epocaPlantio  String
  epocaColheita String
}

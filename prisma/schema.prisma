generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agricultora {
  id           Int        @id @default(autoincrement())
  nome         String
  contato      String     @unique
  senhaHash    String
  // true quando a responsável gerou uma senha provisória: no próximo login ela cria uma nova
  senhaProvisoria Boolean @default(false)
  comunidadeId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comunidade   Comunidade @relation(fields: [comunidadeId], references: [id])
  plantios     Plantio[]
}

model Coordenadora {
  id           Int         @id @default(autoincrement())
  nome         String
  contato      String      @unique
  senhaHash    String
  comunidadeId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  comunidade   Comunidade? @relation(fields: [comunidadeId], references: [id])

  @@index([comunidadeId])
}

model Comunidade {
  id           Int           @id @default(autoincrement())
  nome         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agricultoras Agricultora[]
  coordenadoras Coordenadora[]
}

model Plantio {
  id            Int         @id @default(autoincrement())
  especie       String
  dataPlantio   DateTime
  area          Float
  tipoCultivo   String
  // Colheita (saída do estoque): preenchidos quando a agricultora registra a colheita
  dataColheita      DateTime?
  quantidadeColhida Float?
  agricultoraId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  agricultora   Agricultora @relation(fields: [agricultoraId], references: [id], onDelete: Cascade)
  gastos        Gasto[]
  vendas        Venda[]

  @@index([especie])
  @@index([dataPlantio])
}

// Finanças do plantio: o que a agricultora GASTOU (semente, adubo...) e o que VENDEU.
// Dinheiro sempre em Decimal (centavos exatos), nunca Float.
model Gasto {
  id        Int      @id @default(autoincrement())
  plantioId Int
  categoria String   // SEMENTE, ADUBO, MAO_DE_OBRA, TRANSPORTE ou OUTRO
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plantio   Plantio  @relation(fields: [plantioId], references: [id], onDelete: Cascade)

  @@index([plantioId])
  @@index([data])
}

// Venda = saída do estoque colhido (kg). Só existe depois da colheita.
model Venda {
  id           Int      @id @default(autoincrement())
  plantioId    Int
  quantidadeKg Float
  precoKg      Decimal  @db.Decimal(12, 2)
  canal        String   // FEIRA, PNAE, ATRAVESSADOR ou OUTRO
  data         DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plantio      Plantio  @relation(fields: [plantioId], references: [id], onDelete: Cascade)

  @@index([plantioId])
  @@index([data])
}

// Pedido de "esqueci minha senha" por e-mail. Guarda só o HASH do token do link,
// nunca o token em si. Vale 30 minutos e só pode ser usado uma vez.
model RedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  tipo      String    // AGRICULTORA ou COORDENADORA (a conta pode estar em qualquer das duas tabelas)
  usuarioId Int
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([tipo, usuarioId])
}

model CalendarioAgricola {
  id            Int    @id @default(autoincrement())
  especie       String @unique
  epocaPlantio  String
  epocaColheita String
}
